# ============================================================
#  JARVIS Console : réglages de démarrage (facultatifs)
#  Tout le reste se règle dans l'interface : Configuration (Ctrl+,).
#  Pour les utiliser, copie ce fichier en ".env" et décommente.
#  Aucune clé API n'est nécessaire : la console utilise tes
#  abonnements Claude via Claude Code.
# ============================================================

# Port du serveur local (sinon celui de la configuration, 8788 par défaut)
# CONSOLE_PORT=8788

# Dossier des données (configuration, historique, journal d'audit, jeton)
# CONSOLE_DATA_DIR=C:/Users/TonNom/JarvisConsoleData

# 1 = ne pas ouvrir le navigateur au démarrage
# CONSOLE_NO_BROWSER=1

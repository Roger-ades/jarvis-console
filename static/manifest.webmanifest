{
  "id": "/",
  "name": "JARVIS · Console d'agents",
  "short_name": "JARVIS",
  "description": "Console locale d'agents Claude Code : tâches parallèles, deux comptes, validations, routines.",
  "lang": "fr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#06080c",
  "theme_color": "#06080c",
  "icons": [
    { "src": "/static/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/img/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Routines", "url": "/#routines", "icons": [{ "src": "/static/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sessions", "url": "/#sessions", "icons": [{ "src": "/static/img/icon-192.png", "sizes": "192x192" }] }
  ]
}
